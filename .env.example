# ──────────────────────────────────────────────────────────────────────────
# YT Automation — Clipping Path · environment template
# Copy to `.env` and fill in real values. NEVER commit the populated .env.
# Placeholders only here. Secrets live in env/vault, never in source.
# ──────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ── Postgres 16 + pgvector ────────────────────────────────────────────────
# Matches docker/docker-compose.yml service `postgres`.
POSTGRES_USER=ytauto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ytauto
POSTGRES_HOST=localhost
POSTGRES_PORT=5433              # host port (container is 5432; 5433 avoids local-PG clash)
# Async driver for SQLModel/SQLAlchemy. asyncpg.
DATABASE_URL=postgresql+asyncpg://ytauto:change-me@localhost:5433/ytauto

# ── Redis Streams (queue / events) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object store (S3-compatible · MinIO in dev) ───────────────────────────
# Matches docker/docker-compose.yml service `minio`.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=studio-assets
S3_FORCE_PATH_STYLE=true            # required for MinIO

# ── Transcript: download-first, ASR-second ────────────────────────────────
# Tier A (YouTube captions) needs no key (youtube-transcript-api / yt-dlp).
# Tier B fallback: Cartesia Ink-Whisper batch STT (we have credits).
CARTESIA_API_KEY=
CARTESIA_BASE_URL=https://api.cartesia.ai
# pyannote diarization (HuggingFace gated model access token).
HUGGINGFACE_TOKEN=

# ── Models: Purdue GenAI (RCAC) — OpenAI-compatible gateway ───────────────
# RATE LIMITED to ~20 requests/min across ALL calls. A global token-bucket
# limiter + 429 backoff is REQUIRED (see CLAUDE.md). Multimodal judge sees
# frames -> MUST be llama4 (or gemma3:27b). Text tasks -> gpt-oss / smaller.
LLM_API_BASE_URL=                   # Purdue GenAI OpenAI-compatible base URL (copy from the GenAI portal)
LLM_API_KEY=                        # your Purdue GenAI API key
LLM_RATE_LIMIT_RPM=20               # hard cap; limiter must stay under this
LLM_MAX_CONCURRENCY=2               # keep small so bursts don't trip 429s
MODEL_JUDGE=llama4:latest           # multimodal clip judge (primary)
MODEL_JUDGE_BACKUP=gemma3:27b       # multimodal fallback
MODEL_TEXT_HEAVY=gpt-oss:120b       # heavy text reasoning (text-only)
MODEL_TEXT_MID=deepseek-r1:14b      # mid text reasoning
MODEL_TEXT_CHEAP=gemma3:1b          # cheap structured/JSON/routing

# ── External audience signals ─────────────────────────────────────────────
# YouTube most-replayed: scraped via yt-dlp (no key). Data API optional for
# richer analytics/most-replayed access.
YOUTUBE_API_KEY=
# Twitch Helix top-clips (revealed-preference highlights).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Publish + analytics (YouTube MCP / Data API OAuth) ────────────────────
# Used at the publish stage; rights re-checked fail-closed before upload.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ── Cost discipline ───────────────────────────────────────────────────────
# Cheap filter → expensive judge on the shortlist only; enforce per-run cap.
BUDGET_CENTS_PER_SOURCE=500
BUDGET_CENTS_PER_CLIP=100

# Narrator voice. Leave both blank to use the default in studio/voices.py (Carson, "curious").
#   CARTESIA_VOICE     — a take from studio/voices.py: curious | disgust | angry | surprise
#   CARTESIA_VOICE_ID  — an explicit Cartesia id; wins over CARTESIA_VOICE (custom clones go here)
CARTESIA_VOICE=
CARTESIA_VOICE_ID=

# ffmpeg build used for rendering. The default Homebrew ffmpeg has NO libass, so caption
# burn-in refuses (the PNG-overlay fallback is capped at 50 cues and an 8-min video needs ~210).
# Install once with: brew install ffmpeg-full   (keg-only, does not replace your default ffmpeg)
FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
